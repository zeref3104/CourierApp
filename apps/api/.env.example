# Environment Variables
# Copy this file to .env and fill in your values

NODE_ENV=development
PORT=3000

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_ROOT_PASSWORD=changeme
MASTER_DB_NAME=courier_master
MONGO_POOL_SIZE=10

# JWT — REQUIRED: server will NOT start without these
JWT_SECRET=your-secret-key-at-least-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Super Admin (used by seed script)
SUPER_ADMIN_EMAIL=admin@courier.com
SUPER_ADMIN_PASSWORD=Admin123456

# Tenant
DEV_TENANT_SLUG=testco2
TENANT_PREFIX=CPR

# Cloudinary — set for photo uploads & receipt PDF generation
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP / Email notifications — set for email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@courier.app

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100