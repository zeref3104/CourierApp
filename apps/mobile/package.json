{
  "name": "@courier/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Courier client mobile app (Expo SDK 56 / React Native 0.85)",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "set NODE_PATH=.\\node_modules&& jest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "~2.2.0",
    "axios": "^1.19.0",
    "expo": "~56.0.18",
    "expo-constants": "~56.0.22",
    "expo-font": "~56.0.7",
    "expo-linking": "~56.0.16",
    "expo-router": "~56.2.17",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@expo/log-box": "~56.0.14",
    "@expo/metro-runtime": "~56.0.18",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~13.2.5",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.5",
    "typescript": "~5.7.2"
  },
  "jest": {
    "preset": "jest-expo",
    "rootDir": ".",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts"
    ]
  }
}