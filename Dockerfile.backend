# ============================================================================
# Courier backend API — single-stage runtime image
# npm-workspaces monorepo: `npm ci` hoists SOME deps to the root node_modules
# but keeps others in apps/api/node_modules (mongoose, ioredis, ...). Both must
# live in the SAME stage as the runtime — copying node_modules across stages
# would lose the non-hoisted ones and crash with "Cannot find module".
# ============================================================================

FROM node:20-alpine

RUN apk add --no-cache libc6-compat

# Create the non-root user FIRST (order matters for --chown in later COPYs)
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 express

WORKDIR /app

# Cache layer: npm ci depends only on these manifests, so source edits won't
# re-install. We must copy EVERY workspace member declared in the root
# package.json (apps/* + packages/*), or npm ci fails with "Could not read
# package.json".
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/mobile/package.json ./apps/mobile/
COPY apps/web/package.json ./apps/web/
COPY packages/constants/package.json ./packages/constants/
COPY packages/helpers/package.json ./packages/helpers/
COPY packages/validation/package.json ./packages/validation/

# Production install. --omit=dev keeps jest/nodemon/vite out of the runtime
# image while resolving the @courier/* workspace links against packages/*.
# npm ci only materializes /app/node_modules when every workspace is present.
RUN npm ci --omit=dev

# Full source AFTER install: COPY only adds, so the freshly installed
# node_modules (root + apps/api/node_modules) survives.
COPY --chown=express:nodejs . .

RUN mkdir -p logs && chown express:nodejs logs

USER express
EXPOSE 3003
ENV NODE_ENV=production

# server.js lives in the app workspace, not at /app/src
CMD ["node", "apps/api/src/server.js"]