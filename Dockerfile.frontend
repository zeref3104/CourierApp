# ============================================================================
# Courier frontend — Vite SPA build + static serve (Caddy)
# npm-workspaces monorepo: `npm ci` hoists SOME deps to the root node_modules
# but keeps others in apps/*/node_modules (react-dom, @vitejs/plugin-react,
# recharts, ...). For that reason deps install and build must happen in the
# SAME stage — a cross-stage node_modules copy would lose the non-hoisted ones.
# ============================================================================

# ---------------------------------------------------------------------------
# Stage build — install full workspace (dev deps included: vite, tsc, tailwind)
# ---------------------------------------------------------------------------
FROM node:20-alpine AS build
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Cache layer: install depends only on the manifests below.
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/mobile/package.json ./apps/mobile/
COPY apps/web/package.json ./apps/web/
COPY packages/constants/package.json ./packages/constants/
COPY packages/helpers/package.json ./packages/helpers/
COPY packages/validation/package.json ./packages/validation/

# Full workspace install (dev deps included: vite, tsc, tailwind).
# Use `npm install`, NOT `npm ci`: npm ci drops the platform-specific optional
# native binaries via a workspaces bug (#4828) — the force-install in the next
# RUN guarantees them regardless. (Lockfile is generated on Windows, so it only
# lists the win32 native packages.)
RUN npm install

# npm still skips the platform-specific optional native binaries because the
# lockfile was recorded on Windows. Force-install the ones for THIS build
# platform (alpine/musl) — the -gnu variant would be rejected with EBADPLATFORM.
# Versions are read from the installed packages (they are version-locked to
# rollup and esbuild cores).
RUN ROLLUP_VERSION=$(node -e "console.log(require(require.resolve('rollup/package.json', { paths: ['/app/apps/web'] })).version)") \
 && ESBUILD_VERSION=$(node -e "console.log(require(require.resolve('esbuild/package.json', { paths: ['/app/apps/web'] })).version)") \
 && npm install --no-save \
      @rollup/rollup-linux-x64-musl@$ROLLUP_VERSION \
      @esbuild/linux-x64-musl@$ESBUILD_VERSION

# Source of the whole monorepo: vite bundles @courier/helpers+constants from
# packages/*, the build runs ../../scripts/check-i18n.mjs, and the just-installed
# node_modules (root + apps/*/node_modules) is PRESERVED because COPY only adds.
COPY . .

# Build the web SPA. Output defaults to <app>/apps/web/dist.
RUN npm run build --workspace @courier/web

# ---------------------------------------------------------------------------
# Stage runner — serve the static bundle with Caddy (SPA fallback)
# ---------------------------------------------------------------------------
FROM caddy:2-alpine

# Only the compiled assets go to the runtime image.
COPY --from=build /app/apps/web/dist /srv

# Static file server with SPA try_files fallback. Binds $PORT (Railway/Cloud
# providers) and defaults to 80.
COPY <<'EOF' /etc/caddy/Caddyfile
{$PORT:80}

root * /srv
try_files {path} /index.html
file_server
EOF

EXPOSE 80