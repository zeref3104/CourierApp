# ============================================================================
# Courier frontend — Vite SPA build + static serve (nginx, same as stockinapp.us)
# npm-workspaces monorepo: `npm ci` hoists SOME deps to the root node_modules
# but keeps others in apps/*/node_modules (react-dom, @vitejs/plugin-react,
# recharts, ...). For that reason deps install and build must happen in the
# SAME stage — a cross-stage node_modules copy would lose the non-hoisted ones.
# ============================================================================

# ---------------------------------------------------------------------------
# Stage build — install full workspace (dev deps included: vite, tsc, tailwind)
# ---------------------------------------------------------------------------
FROM node:20-alpine AS build
RUN apk add --no-cache libc6-compat
WORKDIR /app

# API URL for the build — pass with --build-arg VITE_API_URL=... (same pattern
# as the working stockinapp.us Dockerfile). Vite bakes this into the bundle.
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# Cache layer: install depends only on the manifests below.
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/mobile/package.json ./apps/mobile/
COPY apps/web/package.json ./apps/web/
COPY packages/constants/package.json ./packages/constants/
COPY packages/helpers/package.json ./packages/helpers/
COPY packages/validation/package.json ./packages/validation/

# Full workspace install (dev deps included: vite, tsc, tailwind).
# Use `npm install`, NOT `npm ci`: npm ci drops the platform-specific optional
# native binaries via a workspaces bug (#4828) — the force-install in the next
# RUN guarantees them regardless. (Lockfile is generated on Windows, so it only
# lists the win32 native packages.)
RUN npm install

# npm still skips rollup's platform-specific optional native binary because the
# lockfile was recorded on Windows. Force-install ONLY @rollup/rollup-linux-x64-musl,
# which is the exact module rollup's native.js reports missing on Alpine.
# esbuild needs no separate musl package (its linux binary runs on both libcs).
# The version is read from the installed package (it is version-locked to rollup).
RUN ROLLUP_VERSION=$(node -e "console.log(require(require.resolve('rollup/package.json', { paths: ['/app/apps/web'] })).version)") \
 && npm install --no-save @rollup/rollup-linux-x64-musl@$ROLLUP_VERSION

# Source of the whole monorepo: vite bundles @courier/helpers+constants from
# packages/*, the build runs ../../scripts/check-i18n.mjs, and the just-installed
# node_modules (root + apps/*/node_modules) is PRESERVED because COPY only adds.
COPY . .

# Build the web SPA. Output defaults to <app>/apps/web/dist.
RUN npm run build --workspace @courier/web

# ---------------------------------------------------------------------------
# Stage runner — serve the static bundle with nginx (SPA fallback)
# Same server engine as the working stockinapp.us deployment (nginx).
# ---------------------------------------------------------------------------
FROM nginx:alpine

# Only the compiled assets go to the runtime image.
COPY --from=build /app/apps/web/dist /usr/share/nginx/html

# Static file server with SPA try_files fallback. Listens on 80 inside the
# container (Dokploy app port must be 80).
RUN rm -f /etc/nginx/conf.d/default.conf
COPY <<'EOF' /etc/nginx/conf.d/courier.conf
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Security headers (same as stockinapp.us)
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Hashed build assets: cache hard, and NEVER SPA-fallback a missing asset
    # (avoids the Caddy "index.html served as text/html" white-screen gotcha).
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
EOF

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]